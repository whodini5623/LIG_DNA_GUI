<UserControl x:Class="BroadcastControl.App.View.RecordingPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="142" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="152" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="54" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Orientation="Horizontal" Opacity="{Binding RecordingIndicatorOpacity}">
            <Ellipse Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"
                     Fill="{Binding RecordingIndicatorBrush}" />
            <TextBlock Foreground="{Binding RecordingTextBrush}" FontSize="18" FontWeight="Bold"
                       Text="{Binding Text[RecordingOn]}" />
        </StackPanel>
        <Button Grid.Column="2" Click="OpenRecordedVideosButton_OnClick" Style="{DynamicResource TopBarButton}"
                Content="{Binding Text[RecordedData]}" />
        <Button Grid.Column="4" Command="{Binding ToggleSettingsCommand}"
                Style="{DynamicResource TopBarButton}" Padding="0">
            <materialDesign:PackIcon Kind="Cog" Width="22" Height="22" />
        </Button>
    </Grid>
</UserControl>
