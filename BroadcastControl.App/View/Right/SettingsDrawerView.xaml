<UserControl x:Class="BroadcastControl.App.View.SettingsDrawerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
<Rectangle x:Name="SettingsBackdrop"

                   Fill="#22000000"

                   Opacity="0"

                   Visibility="Collapsed"

                   IsHitTestVisible="False"

                   Panel.ZIndex="20"

                   MouseLeftButtonDown="SettingsBackdrop_OnMouseLeftButtonDown" />
<Border x:Name="SettingsDrawer"

                Width="280"

                Margin="0,12,12,12"

                HorizontalAlignment="Right"

                VerticalAlignment="Stretch"

                Background="{DynamicResource DrawerBrush}"

                BorderBrush="{DynamicResource DrawerBorderBrush}"

                BorderThickness="1"

                Padding="22"

                Effect="{StaticResource DrawerShadow}"

                UseLayoutRounding="True"

                SnapsToDevicePixels="True"

                Opacity="0"

                Visibility="Collapsed"

                Panel.ZIndex="21">

                <Border.RenderTransform>

                    <!-- 기본 ?�치???�면 ?�른�?바깥?? ?�릴 ???�쪽?�로 부?�럽�??�동?? -->

                    <TranslateTransform x:Name="SettingsDrawerTransform" X="320" />

                </Border.RenderTransform>

                <Border.CacheMode>

                    <BitmapCache RenderAtScale="1" />

                </Border.CacheMode>

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>



                    <TextBlock Text="{Binding Text[Settings]}"

                           FontSize="24"

                           FontWeight="Bold"

                           Foreground="{DynamicResource DrawerTextBrush}" />



                    <Border Grid.Row="1"

                        Margin="0,18,0,14"

                        BorderBrush="{DynamicResource DrawerBorderBrush}"

                        BorderThickness="0,0,0,3">

                        <TextBlock Margin="0,0,0,10"

                               Text="{Binding Text[PrimaryTargetChange]}"

                               FontSize="18"

                               FontWeight="SemiBold"

                               Foreground="{DynamicResource DrawerTextBrush}" />

                    </Border>



                    <ItemsControl Grid.Row="2"

                              ItemsSource="{Binding PrimaryTargets}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Button Margin="0,0,0,10"

                                    Command="{Binding DataContext.SelectPrimaryTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                    CommandParameter="{Binding Value}"

                                    Style="{StaticResource SettingsActionButton}"

                                    Content="{Binding DisplayName}" />

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>



                    <Border Grid.Row="3"

                        Margin="0,8,0,12"

                        BorderBrush="{DynamicResource DrawerBorderBrush}"

                        BorderThickness="0,1,0,0">

                        <TextBlock Margin="0,12,0,0"

                               Text="{Binding Text[ThemeChange]}"

                               FontSize="18"

                               FontWeight="SemiBold"

                               Foreground="{DynamicResource DrawerTextBrush}" />

                    </Border>



                    <Grid Grid.Row="4">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"

                            Margin="0,0,8,0"

                            Command="{Binding SetThemeCommand}"

                            CommandParameter="Dark"

                            Opacity="{Binding DarkThemeButtonOpacity}"

                            Style="{StaticResource SettingsActionButton}"

                            Content="{Binding Text[DarkTheme]}" />

                        <Button Grid.Column="1"

                            Command="{Binding SetThemeCommand}"

                            CommandParameter="Light"

                            Opacity="{Binding LightThemeButtonOpacity}"

                            Style="{StaticResource SettingsActionButton}"

                            Content="{Binding Text[LightTheme]}" />

                    </Grid>



                    <Border Grid.Row="5"

                        Margin="0,18,0,12"

                        BorderBrush="{DynamicResource DrawerBorderBrush}"

                        BorderThickness="0,1,0,0">

                        <TextBlock Margin="0,12,0,0"

                               Text="{Binding Text[LanguageChange]}"

                               FontSize="18"

                               FontWeight="SemiBold"

                               Foreground="{DynamicResource DrawerTextBrush}" />

                    </Border>



                    <Grid Grid.Row="6">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"

                            Margin="0,0,8,0"

                            Command="{Binding SetLanguageCommand}"

                            CommandParameter="English"

                            Opacity="{Binding EnglishLanguageButtonOpacity}"

                            Style="{StaticResource SettingsActionButton}"

                            Content="{Binding Text[English]}" />

                        <Button Grid.Column="1"

                            Command="{Binding SetLanguageCommand}"

                            CommandParameter="Korean"

                            Opacity="{Binding KoreanLanguageButtonOpacity}"

                            Style="{StaticResource SettingsActionButton}"

                            Content="{Binding Text[Korean]}" />

                    </Grid>



                    <Border Grid.Row="7"

                        Margin="0,18,0,12"

                        BorderBrush="{DynamicResource DrawerBorderBrush}"

                        BorderThickness="0,1,0,0">

                        <TextBlock Margin="0,12,0,0"

                               Text="{Binding Text[ScreenMode]}"

                               FontSize="18"

                               FontWeight="SemiBold"

                               Foreground="{DynamicResource DrawerTextBrush}" />

                    </Border>



                    <Button x:Name="WindowModeToggleButton"

                        Grid.Row="8"

                        Click="WindowModeToggleButton_OnClick"

                        Style="{StaticResource SettingsActionButton}"

                        Content="{Binding Text[WindowMode]}" />

                </Grid>

            </Border>
 </Grid>
</UserControl>
