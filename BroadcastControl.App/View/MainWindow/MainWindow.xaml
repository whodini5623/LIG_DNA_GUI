<Window x:Class="BroadcastControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:panels="clr-namespace:BroadcastControl.App.View.Panels"
        Title="LIG DNA GUI"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <DropShadowEffect x:Key="SoftPanelShadow"
                          BlurRadius="10"
                          ShadowDepth="1"
                          Direction="270"
                          Opacity="0.12"
                          Color="#66000000" />

        <DropShadowEffect x:Key="TopBarShadow"
                          BlurRadius="6"
                          ShadowDepth="0"
                          Direction="270"
                          Opacity="0.12"
                          Color="#66000000" />

        <DropShadowEffect x:Key="DrawerShadow"
                          BlurRadius="10"
                          ShadowDepth="1"
                          Direction="270"
                          Opacity="0.10"
                          Color="#66000000" />

        <Style x:Key="GlassCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Effect" Value="{StaticResource SoftPanelShadow}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="OverlayCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource OverlayPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>

        <Style x:Key="TopBarButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource TopBarButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TopBarButtonHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TopBarButtonPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopBarSmallButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource TopBarButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TopBarButtonHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TopBarButtonPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopBarCompactSlider" TargetType="Slider">
            <Setter Property="Height" Value="14" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Opacity" Value="0.9" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource OverlayPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />
        </Style>

        <Style x:Key="MotorPadButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#33475663" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#55475663" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#66475663" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InlineRotateButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F475663" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#33475663" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlaybackIconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#22313A46" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33475663" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#55475663" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="SettingsActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource DrawerItemBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DrawerItemBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DrawerTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />
        </Style>

        <Style x:Key="ZoomSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="14" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.72" ScaleY="0.72" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Grid x:Name="RootLayout"
          Width="1600"
          Height="900">
            <!-- ?„ì²´ ì°?ìµœìƒ??ì»¨í…Œ?´ë„ˆ??
             ?ë‹¨ ?´ë°”, ë³¸ë¬¸ ?¨ë„, ?¤ì • ?œë¡œ?´ë? ??Grid ?ˆì— ë°°ì¹˜ -->
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Rectangle Grid.RowSpan="2"
                       Margin="-4"
                       IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <DynamicResource ResourceKey="WindowBackdropBrush" />
                    </Rectangle.Fill>
                </Rectangle>

                <!-- ?ë‹¨ ?´ë°”:
                 ?„ì› ì¢…ë£Œ, ?¹í™” ?íƒœ, ë°ê¸°/?€ì¡°ë¹„, ëª¨ë“œ ?„í™˜, ?¤ì • ë²„íŠ¼ ë°°ì¹˜ -->
                <Border Grid.Row="0"
                    Visibility="Collapsed"
                    Style="{StaticResource GlassCardBorder}"
                    CornerRadius="2"
                    Effect="{StaticResource TopBarShadow}">
                    <Grid Margin="14,10,42,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="152" />
                            <ColumnDefinition Width="152" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                            MinWidth="126"
                            Command="{Binding TogglePowerCommand}"
                            Style="{StaticResource TopBarButton}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="16"
                                     Height="16"
                                     Margin="0,0,8,0"
                                     Fill="{Binding CurrentThreatBrush}" />
                                <TextBlock Text="{Binding PowerButtonText}" />
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Opacity="{Binding RecordingIndicatorOpacity}">
                            <Ellipse Width="12"
                                 Height="12"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding RecordingIndicatorBrush}" />
                            <TextBlock VerticalAlignment="Center"
                                   Foreground="{Binding RecordingTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{Binding Text[RecordingOn]}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <Button HorizontalAlignment="Left"
                                Command="{Binding ResetBrightnessCommand}"
                                Style="{StaticResource TopBarSmallButton}"
                                Content="{Binding BrightnessText}" />
                            <Slider Margin="0,2,0,0"
                                Minimum="0"
                                Maximum="100"
                                Style="{StaticResource TopBarCompactSlider}"
                                Value="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsSystemPoweredOn}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center">
                            <Button HorizontalAlignment="Left"
                                Command="{Binding ResetContrastCommand}"
                                Style="{StaticResource TopBarSmallButton}"
                                Content="{Binding ContrastText}" />
                            <Slider Margin="0,2,0,0"
                                Minimum="0"
                                Maximum="100"
                                Style="{StaticResource TopBarCompactSlider}"
                                Value="{Binding Contrast, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsSystemPoweredOn}" />
                        </StackPanel>

                        <Button Grid.Column="4"
                            Margin="0,0,8,0"
                            Width="92"
                            Command="{Binding SetModeCommand}"
                            CommandParameter="&#xC790;&#xB3D9;"
                            IsHitTestVisible="{Binding CanSelectAutoMode}"
                            Opacity="{Binding AutoModeOpacity}"
                            Style="{StaticResource TopBarButton}"
                            Content="{Binding Text[AutoMode]}" />

                        <Button Grid.Column="5"
                            Margin="0,0,8,0"
                            Width="92"
                            Command="{Binding SetModeCommand}"
                            CommandParameter="&#xC218;&#xB3D9;"
                            IsHitTestVisible="{Binding CanSelectManualMode}"
                            Opacity="{Binding ManualModeOpacity}"
                            Style="{StaticResource TopBarButton}"
                            Content="{Binding Text[ManualMode]}" />

                        <Button Grid.Column="6"
                            Width="84"
                            Margin="0,0,12,0"
                            Padding="10,4"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Style="{StaticResource TopBarSmallButton}"
                            Opacity="{Binding ManualRecordingButtonOpacity}"
                            IsEnabled="{Binding IsManualMode}"
                            Command="{Binding ToggleManualRecordingCommand}"
                            Content="{Binding ManualRecordingButtonText}" />

                        <Button Grid.Column="7"
                            Width="54"
                            Command="{Binding ToggleSettingsCommand}"
                            Style="{StaticResource TopBarButton}">
                            <materialDesign:PackIcon Kind="Menu"
                                                 Width="24"
                                                 Height="24" />
                        </Button>
                    </Grid>
                </Border>

                <!-- ë³¸ë¬¸ ?ì—­:
                 ?¼ìª½ ì¹´ë©”???”ë©´, ?¤ë¥¸ìª??œìŠ¤???„í™©/?í™© ë¶„ì„/?œìŠ¤??ë¡œê·¸ ?¨ë„ -->
                <Grid Grid.Row="1"
                  Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0"
                      Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="74" />
                            <RowDefinition Height="150" />
                            <RowDefinition Height="128" />
                            <RowDefinition Height="138" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0"
                            Margin="0,0,0,12"
                            Command="{Binding TogglePowerCommand}"
                            Style="{StaticResource TopBarButton}">
                            <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding PowerButtonText}" />
                                <Ellipse Width="10"
                                     Height="10"
                                     Margin="8,1,0,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding CurrentThreatBrush}" />
                            </StackPanel>
                        </Button>

                        <Border Grid.Row="1"
                            Margin="0,0,0,12"
                            Style="{StaticResource GlassCardBorder}"
                            Background="#FF05070A">
                            <Grid Margin="12">
                                <Border Width="108"
                                    Height="25"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource OverlayCardBorder}"
                                    BorderThickness="0"
                                    Padding="7,3">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left"
                                               Text="CAM 1"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="12"
                                               FontWeight="Bold" />
                                        <Button DockPanel.Dock="Right"
                                            Margin="8,0,0,0"
                                            Tag="CAM 1"
                                            Click="RotateAuxCameraButton_OnClick"
                                            Style="{StaticResource InlineRotateButton}">
                                            <materialDesign:PackIcon Kind="RotateRight" Width="12" Height="12" />
                                        </Button>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                            Style="{StaticResource GlassCardBorder}">
                            <Grid Margin="10,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Text="{Binding Text[MotorPosition]}" />
                                    <Button Grid.Column="1"
                                        Width="58"
                                        Height="23"
                                        Padding="6,1"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Command="{Binding ToggleMotorDetailsCommand}"
                                        Style="{StaticResource TopBarSmallButton}"
                                        Content="{Binding Text[Details]}" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                        Margin="0,0,4,0"
                                        Padding="7,5"
                                        Background="{DynamicResource OverlayPanelBrush}"
                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   Text="Pan" />
                                            <TextBlock Grid.Row="1"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   Text="{Binding PanMotorPositionText}" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1"
                                        Margin="4,0,0,0"
                                        Padding="7,5"
                                        Background="{DynamicResource OverlayPanelBrush}"
                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   Text="Tilt" />
                                            <TextBlock Grid.Row="1"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   Text="{Binding TiltMotorPositionText}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3"
                            Margin="0,12,0,0"
                            Style="{StaticResource GlassCardBorder}">
                            <Grid Margin="10"
                              IsEnabled="{Binding CanUseMotorTargetControls}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Text="{Binding Text[MotorTarget]}" />
                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="62" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Text="Pan" />
                                    <TextBox Grid.Column="1"
                                         Height="29"
                                         Padding="5,3"
                                         FontSize="12"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         Background="{DynamicResource OverlayPanelBrush}"
                                         BorderBrush="{DynamicResource PanelBorderBrush}"
                                         Text="{Binding MotorTargetPanText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="3"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Text="Tilt" />
                                    <TextBox Grid.Column="4"
                                         Height="29"
                                         Padding="5,3"
                                         FontSize="12"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         Background="{DynamicResource OverlayPanelBrush}"
                                         BorderBrush="{DynamicResource PanelBorderBrush}"
                                         Text="{Binding MotorTargetTiltText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Button Grid.Row="2"
                                    Height="29"
                                    Margin="0,12,0,0"
                                    Command="{Binding SendMotorTargetCommand}"
                                    Style="{StaticResource TopBarSmallButton}"
                                    Content="Enter" Click="Button_Click_2" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="4"
                            Margin="0,12,0,0"
                            Style="{StaticResource GlassCardBorder}">
                            <Grid Margin="10"
                              VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Text="Step Size (+/-)" />
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button Height="24" Padding="6,1" FontSize="12" FontWeight="Bold" HorizontalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Auto:Pan:Reset" Style="{StaticResource TopBarSmallButton}" Content="Auto Pan" />
                                        <Grid Grid.Row="1" Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Height="31" Padding="0" FontSize="17" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Auto:Pan:-1" Style="{StaticResource TopBarButton}" Content="-" />
                                            <Border Grid.Column="2" Height="33" Background="{DynamicResource OverlayPanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="2">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" Text="{Binding AutoPanMotorStepSizeText}" />
                                            </Border>
                                            <Button Grid.Column="4" Height="31" Padding="0" FontSize="17" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Auto:Pan:1" Style="{StaticResource TopBarButton}" Content="+" />
                                        </Grid>
                                        <Button Grid.Row="2" Margin="0,8,0,0" Height="24" Padding="6,1" FontSize="12" FontWeight="Bold" HorizontalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Auto:Tilt:Reset" Style="{StaticResource TopBarSmallButton}" Content="Auto Tilt" />
                                        <Grid Grid.Row="3" Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Height="31" Padding="0" FontSize="17" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Auto:Tilt:-1" Style="{StaticResource TopBarButton}" Content="-" />
                                            <Border Grid.Column="2" Height="33" Background="{DynamicResource OverlayPanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="2">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" Text="{Binding AutoTiltMotorStepSizeText}" />
                                            </Border>
                                            <Button Grid.Column="4" Height="31" Padding="0" FontSize="17" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Auto:Tilt:1" Style="{StaticResource TopBarButton}" Content="+" />
                                        </Grid>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
