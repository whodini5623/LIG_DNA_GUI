<Window x:Class="BroadcastControl.App.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"

        xmlns:view="clr-namespace:BroadcastControl.App.View"
        xmlns:left="clr-namespace:BroadcastControl.App.View"
        xmlns:middle="clr-namespace:BroadcastControl.App.View.Middle"

        Title="LIG DNA GUI"

        WindowState="Maximized"

        WindowStyle="None"

        ResizeMode="NoResize"

        Background="{DynamicResource WindowBackgroundBrush}"

        UseLayoutRounding="True"

        SnapsToDevicePixels="True"

        TextOptions.TextFormattingMode="Display"

        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />



        <DropShadowEffect x:Key="SoftPanelShadow"

                          BlurRadius="10"

                          ShadowDepth="1"

                          Direction="270"

                          Opacity="0.12"

                          Color="#66000000" />



        <DropShadowEffect x:Key="TopBarShadow"

                          BlurRadius="6"

                          ShadowDepth="0"

                          Direction="270"

                          Opacity="0.12"

                          Color="#66000000" />



        <DropShadowEffect x:Key="DrawerShadow"

                          BlurRadius="10"

                          ShadowDepth="1"

                          Direction="270"

                          Opacity="0.10"

                          Color="#66000000" />



        <Style x:Key="GlassCardBorder" TargetType="Border">

            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />

            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="CornerRadius" Value="2" />

            <Setter Property="Effect" Value="{StaticResource SoftPanelShadow}" />

            <Setter Property="SnapsToDevicePixels" Value="True" />

        </Style>



        <Style x:Key="OverlayCardBorder" TargetType="Border">

            <Setter Property="Background" Value="{DynamicResource OverlayPanelBrush}" />

            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="CornerRadius" Value="2" />

        </Style>



        <Style x:Key="TopBarButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">

            <Setter Property="Height" Value="40" />

            <Setter Property="Padding" Value="14,8" />

            <Setter Property="FontSize" Value="14" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Background" Value="{DynamicResource TopBarButtonBrush}" />

            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />

            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="{DynamicResource TopBarButtonHoverBrush}" />

                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />

                </Trigger>

                <Trigger Property="IsPressed" Value="True">

                    <Setter Property="Background" Value="{DynamicResource TopBarButtonPressedBrush}" />

                </Trigger>

            </Style.Triggers>

        </Style>



        <Style x:Key="TopBarSmallButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">

            <Setter Property="Height" Value="24" />

            <Setter Property="Padding" Value="8,2" />

            <Setter Property="FontSize" Value="11" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Background" Value="{DynamicResource TopBarButtonBrush}" />

            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />

            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="{DynamicResource TopBarButtonHoverBrush}" />

                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />

                </Trigger>

                <Trigger Property="IsPressed" Value="True">

                    <Setter Property="Background" Value="{DynamicResource TopBarButtonPressedBrush}" />

                </Trigger>

            </Style.Triggers>

        </Style>



        <Style x:Key="TopBarCompactSlider" TargetType="Slider">

            <Setter Property="Height" Value="14" />

            <Setter Property="LayoutTransform">

                <Setter.Value>

                    <ScaleTransform ScaleX="0.72" ScaleY="0.72" />

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">

            <Setter Property="Width" Value="44" />

            <Setter Property="Height" Value="44" />

            <Setter Property="Opacity" Value="0.9" />

            <Setter Property="Padding" Value="0" />

            <Setter Property="Background" Value="{DynamicResource OverlayPanelBrush}" />

            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />

            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />

            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />

        </Style>



        <Style x:Key="MotorPadButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">

            <Setter Property="Width" Value="34" />

            <Setter Property="Height" Value="28" />

            <Setter Property="Padding" Value="0" />

            <Setter Property="Background" Value="#33475663" />

            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />

            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#55475663" />

                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />

                </Trigger>

                <Trigger Property="IsPressed" Value="True">

                    <Setter Property="Background" Value="#66475663" />

                </Trigger>

            </Style.Triggers>

        </Style>



        <Style x:Key="InlineRotateButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">

            <Setter Property="Width" Value="24" />

            <Setter Property="Height" Value="20" />

            <Setter Property="Padding" Value="0" />

            <Setter Property="Background" Value="#00FFFFFF" />

            <Setter Property="BorderBrush" Value="#55FFFFFF" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />

            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#1F475663" />

                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />

                </Trigger>

                <Trigger Property="IsPressed" Value="True">

                    <Setter Property="Background" Value="#33475663" />

                </Trigger>

            </Style.Triggers>

        </Style>



        <Style x:Key="PlaybackIconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">

            <Setter Property="Width" Value="42" />

            <Setter Property="Height" Value="36" />

            <Setter Property="Padding" Value="0" />

            <Setter Property="Background" Value="#22313A46" />

            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />

            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter Property="Background" Value="#33475663" />

                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />

                </Trigger>

                <Trigger Property="IsPressed" Value="True">

                    <Setter Property="Background" Value="#55475663" />

                </Trigger>

            </Style.Triggers>

        </Style>



        <Style x:Key="PanelTitle" TargetType="TextBlock">

            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />

            <Setter Property="FontSize" Value="18" />

            <Setter Property="FontWeight" Value="Bold" />

        </Style>



        <Style x:Key="SettingsActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">

            <Setter Property="Height" Value="40" />

            <Setter Property="Padding" Value="12,8" />

            <Setter Property="FontSize" Value="14" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Background" Value="{DynamicResource DrawerItemBrush}" />

            <Setter Property="BorderBrush" Value="{DynamicResource DrawerItemBorderBrush}" />

            <Setter Property="Foreground" Value="{DynamicResource DrawerTextBrush}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="2" />

        </Style>



        <Style x:Key="ZoomSliderStyle" TargetType="Slider">

            <Setter Property="Height" Value="14" />

            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />

            <Setter Property="RenderTransform">

                <Setter.Value>

                    <ScaleTransform ScaleX="0.72" ScaleY="0.72" />

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>



    <Viewbox Stretch="Uniform">

        <Grid x:Name="RootLayout"

          Width="1600"

          Height="900">

            <!-- ?�체 �?최상??컨테?�너??

             ?�단 ?�바, 본문 ?�널, ?�정 ?�로?��? ??Grid ?�에 배치 -->

            <Grid Margin="12">

                <Grid.RowDefinitions>

                    <RowDefinition Height="0" />

                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>



                <Rectangle Grid.RowSpan="2"

                       Margin="-4"

                       IsHitTestVisible="False">

                    <Rectangle.Fill>

                        <DynamicResource ResourceKey="WindowBackdropBrush" />

                    </Rectangle.Fill>

                </Rectangle>



                <!-- ?�단 ?�바:

                 ?�원 종료, ?�화 ?�태, 밝기/?�조비, 모드 ?�환, ?�정 버튼 배치 -->

                <Border Grid.Row="0"

                    Visibility="Collapsed"

                    Style="{StaticResource GlassCardBorder}"

                    CornerRadius="2"

                    Effect="{StaticResource TopBarShadow}">

                    <Grid Margin="14,10,42,10">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto" />

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="152" />

                            <ColumnDefinition Width="152" />

                            <ColumnDefinition Width="Auto" />

                            <ColumnDefinition Width="Auto" />

                            <ColumnDefinition Width="96" />

                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>



                        <Button Grid.Column="0"

                            MinWidth="126"

                            Command="{Binding TogglePowerCommand}"

                            Style="{StaticResource TopBarButton}">

                            <StackPanel Orientation="Horizontal">

                                <Ellipse Width="16"

                                     Height="16"

                                     Margin="0,0,8,0"

                                     Fill="{Binding CurrentThreatBrush}" />

                                <TextBlock Text="{Binding PowerButtonText}" />

                            </StackPanel>

                        </Button>



                        <StackPanel Grid.Column="1"

                                Margin="16,0,0,0"

                                HorizontalAlignment="Left"

                                VerticalAlignment="Center"

                                Orientation="Horizontal"

                                Opacity="{Binding RecordingIndicatorOpacity}">

                            <Ellipse Width="12"

                                 Height="12"

                                 Margin="0,0,8,0"

                                 VerticalAlignment="Center"

                                 Fill="{Binding RecordingIndicatorBrush}" />

                            <TextBlock VerticalAlignment="Center"

                                   Foreground="{Binding RecordingTextBrush}"

                                   FontSize="13"

                                   FontWeight="SemiBold"

                                   Text="{Binding Text[RecordingOn]}" />

                        </StackPanel>



                        <StackPanel Grid.Column="2"

                                Margin="0,0,12,0"

                                VerticalAlignment="Center">

                            <Button HorizontalAlignment="Left"

                                Command="{Binding ResetBrightnessCommand}"

                                Style="{StaticResource TopBarSmallButton}"

                                Content="{Binding BrightnessText}" />

                            <Slider Margin="0,2,0,0"

                                Minimum="0"

                                Maximum="100"

                                Style="{StaticResource TopBarCompactSlider}"

                                Value="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}"

                                IsEnabled="{Binding IsSystemPoweredOn}" />

                        </StackPanel>



                        <StackPanel Grid.Column="3"

                                Margin="0,0,14,0"

                                VerticalAlignment="Center">

                            <Button HorizontalAlignment="Left"

                                Command="{Binding ResetContrastCommand}"

                                Style="{StaticResource TopBarSmallButton}"

                                Content="{Binding ContrastText}" />

                            <Slider Margin="0,2,0,0"

                                Minimum="0"

                                Maximum="100"

                                Style="{StaticResource TopBarCompactSlider}"

                                Value="{Binding Contrast, UpdateSourceTrigger=PropertyChanged}"

                                IsEnabled="{Binding IsSystemPoweredOn}" />

                        </StackPanel>



                        <Button Grid.Column="4"

                            Margin="0,0,8,0"

                            Width="92"

                            Command="{Binding SetModeCommand}"

                            CommandParameter="&#xC790;&#xB3D9;"

                            IsHitTestVisible="{Binding CanSelectAutoMode}"

                            Opacity="{Binding AutoModeOpacity}"

                            Style="{StaticResource TopBarButton}"

                            Content="{Binding Text[AutoMode]}" />



                        <Button Grid.Column="5"

                            Margin="0,0,8,0"

                            Width="92"

                            Command="{Binding SetModeCommand}"

                            CommandParameter="&#xC218;&#xB3D9;"

                            IsHitTestVisible="{Binding CanSelectManualMode}"

                            Opacity="{Binding ManualModeOpacity}"

                            Style="{StaticResource TopBarButton}"

                            Content="{Binding Text[ManualMode]}" />



                        <Button Grid.Column="6"

                            Width="84"

                            Margin="0,0,12,0"

                            Padding="10,4"

                            FontSize="11"

                            FontWeight="SemiBold"

                            Style="{StaticResource TopBarSmallButton}"

                            Opacity="{Binding ManualRecordingButtonOpacity}"

                            IsEnabled="{Binding IsManualMode}"

                            Command="{Binding ToggleManualRecordingCommand}"

                            Content="{Binding ManualRecordingButtonText}" />



                        <Button Grid.Column="7"

                            Width="54"

                            Command="{Binding ToggleSettingsCommand}"

                            Style="{StaticResource TopBarButton}">

                            <materialDesign:PackIcon Kind="Menu"

                                                 Width="24"

                                                 Height="24" />

                        </Button>

                    </Grid>

                </Border>



                <!-- 본문 ?�역:

                 ?�쪽 카메???�면, ?�른�??�스???�황/?�황 분석/?�스??로그 ?�널 -->

                <Grid Grid.Row="1"

                  Margin="0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="250" />

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="360" />

                    </Grid.ColumnDefinitions>



                    <left:MotorControlPanelView Grid.Column="0" />



                    <!-- 카메???�널:

                     EO �??�면, IR ?�셋 ?�면, 모터 조작 버튼, ?�자 �?UI�??�함?? -->

                    <Grid Grid.Column="1" Margin="0,0,12,0">
 <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
 <middle:CameraWorkspaceView x:Name="CameraWorkspace" Grid.Row="0"/>
 <middle:CameraControlBarView x:Name="CameraControlBar" Grid.Row="1"/>
</Grid>



                    <Grid Grid.Column="2">
 <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="1.44*"/><RowDefinition Height="1.56*"/></Grid.RowDefinitions>
 <view:RecordingPanelView Grid.Row="0" Margin="0,0,0,12" OpenRecordedVideosRequested="OpenRecordedVideosButton_OnClick"/>
 <view:AnalysisPanelView Grid.Row="1"/><view:SystemLogView Grid.Row="2"/>
</Grid>

                </Grid>

            </Grid>



            <view:RecordedVideosView x:Name="RecordedVideosView" Panel.ZIndex="18" />



            <left:MotorDetailsView />



            <!-- SettingsBackdrop?� ?�정�???배경???�둡�?깔고 바깥 ?�릭 ???�는 ?�버?�이?? -->

            <view:SettingsDrawerView x:Name="SettingsDrawerView" Panel.ZIndex="20" WindowModeToggleRequested="WindowModeToggleButton_OnClick" />

        </Grid>

    </Viewbox>

</Window>

