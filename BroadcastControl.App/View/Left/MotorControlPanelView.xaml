<UserControl x:Class="BroadcastControl.App.View.MotorControlPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
<Grid

                      Margin="0,0,12,0">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="74" />

                            <RowDefinition Height="150" />

                            <RowDefinition Height="128" />

                            <RowDefinition Height="138" />

                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>



                        <Button Grid.Row="0"

                            Margin="0,0,0,12"

                            Command="{Binding TogglePowerCommand}"

                            Style="{DynamicResource TopBarButton}">

                            <StackPanel Orientation="Horizontal"

                                    HorizontalAlignment="Center"

                                    VerticalAlignment="Center">

                                <TextBlock Text="{Binding PowerButtonText}" />

                                <Ellipse Width="10"

                                     Height="10"

                                     Margin="8,1,0,0"

                                     VerticalAlignment="Center"

                                     Fill="{Binding CurrentThreatBrush}" />

                            </StackPanel>

                        </Button>



                        <Border Grid.Row="1"

                            Margin="0,0,0,12"

                            Style="{DynamicResource GlassCardBorder}"

                            Background="#FF05070A">

                            <Grid Margin="12">

                                <Border Width="108"

                                    Height="25"

                                    HorizontalAlignment="Left"

                                    VerticalAlignment="Top"

                                    Style="{DynamicResource OverlayCardBorder}"

                                    BorderThickness="0"

                                    Padding="7,3">

                                    <DockPanel LastChildFill="False">

                                        <TextBlock DockPanel.Dock="Left"

                                               Text="CAM 1"

                                               VerticalAlignment="Center"

                                               Foreground="{DynamicResource PrimaryTextBrush}"

                                               FontSize="12"

                                               FontWeight="Bold" />

                                        <Button DockPanel.Dock="Right"

                                            Margin="8,0,0,0"

                                            Tag="CAM 1"

                                            Click="RotateAuxCameraButton_OnClick"

                                            Style="{DynamicResource InlineRotateButton}">

                                            <materialDesign:PackIcon Kind="RotateRight" Width="12" Height="12" />

                                        </Button>

                                    </DockPanel>

                                </Border>

                            </Grid>

                        </Border>



                        <Border Grid.Row="2"

                            Style="{DynamicResource GlassCardBorder}">

                            <Grid Margin="10,8">

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="*" />

                                    <RowDefinition Height="Auto" />

                                </Grid.RowDefinitions>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="Auto" />

                                    </Grid.ColumnDefinitions>

                                    <TextBlock VerticalAlignment="Center"

                                           Foreground="{DynamicResource PrimaryTextBrush}"

                                           FontSize="17"

                                           FontWeight="Bold"

                                           Text="{Binding Text[MotorPosition]}" />

                                    <Button Grid.Column="1"

                                        Width="58"

                                        Height="23"

                                        Padding="6,1"

                                        FontSize="10"

                                        FontWeight="SemiBold"

                                        Command="{Binding ToggleMotorDetailsCommand}"

                                        Style="{DynamicResource TopBarSmallButton}"

                                        Content="{Binding Text[Details]}" />

                                </Grid>

                                <Grid Grid.Row="1" Margin="0,8,0,0">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="*" />

                                    </Grid.ColumnDefinitions>



                                    <Border Grid.Column="0"

                                        Margin="0,0,4,0"

                                        Padding="7,5"

                                        Background="{DynamicResource OverlayPanelBrush}"

                                        BorderBrush="{DynamicResource PanelBorderBrush}"

                                        BorderThickness="1"

                                        CornerRadius="2">

                                        <Grid>

                                            <Grid.RowDefinitions>

                                                <RowDefinition Height="Auto" />

                                                <RowDefinition Height="*" />

                                            </Grid.RowDefinitions>

                                            <TextBlock HorizontalAlignment="Center"

                                                   VerticalAlignment="Center"

                                                   Foreground="{DynamicResource PrimaryTextBrush}"

                                                   FontSize="15"

                                                   FontWeight="Bold"

                                                   TextAlignment="Center"

                                                   Text="Pan" />

                                            <TextBlock Grid.Row="1"

                                                   HorizontalAlignment="Stretch"

                                                   VerticalAlignment="Center"

                                                   Foreground="{DynamicResource PrimaryTextBrush}"

                                                   FontSize="26"

                                                   FontWeight="Bold"

                                                   TextAlignment="Center"

                                                   Text="{Binding PanMotorPositionText}" />

                                        </Grid>

                                    </Border>



                                    <Border Grid.Column="1"

                                        Margin="4,0,0,0"

                                        Padding="7,5"

                                        Background="{DynamicResource OverlayPanelBrush}"

                                        BorderBrush="{DynamicResource PanelBorderBrush}"

                                        BorderThickness="1"

                                        CornerRadius="2">

                                        <Grid>

                                            <Grid.RowDefinitions>

                                                <RowDefinition Height="Auto" />

                                                <RowDefinition Height="*" />

                                            </Grid.RowDefinitions>

                                            <TextBlock HorizontalAlignment="Center"

                                                   VerticalAlignment="Center"

                                                   Foreground="{DynamicResource PrimaryTextBrush}"

                                                   FontSize="15"

                                                   FontWeight="Bold"

                                                   TextAlignment="Center"

                                                   Text="Tilt" />

                                            <TextBlock Grid.Row="1"

                                                   HorizontalAlignment="Stretch"

                                                   VerticalAlignment="Center"

                                                   Foreground="{DynamicResource PrimaryTextBrush}"

                                                   FontSize="26"

                                                   FontWeight="Bold"

                                                   TextAlignment="Center"

                                                   Text="{Binding TiltMotorPositionText}" />

                                        </Grid>

                                    </Border>

                                </Grid>

                            </Grid>

                        </Border>



                        <Border Grid.Row="3"

                            Margin="0,12,0,0"

                            Style="{DynamicResource GlassCardBorder}">

                            <Grid Margin="10"

                              IsEnabled="{Binding CanUseMotorTargetControls}">

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                </Grid.RowDefinitions>

                                <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"

                                       FontSize="16"

                                       FontWeight="Bold"

                                       Text="{Binding Text[MotorTarget]}" />

                                <Grid Grid.Row="1" Margin="0,12,0,0">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="34" />

                                        <ColumnDefinition Width="62" />

                                        <ColumnDefinition Width="14" />

                                        <ColumnDefinition Width="34" />

                                        <ColumnDefinition Width="62" />

                                    </Grid.ColumnDefinitions>

                                    <TextBlock VerticalAlignment="Center"

                                           Foreground="{DynamicResource SecondaryTextBrush}"

                                           FontSize="15"

                                           FontWeight="Bold"

                                           Text="Pan" />

                                    <TextBox Grid.Column="1"

                                         Height="29"

                                         Padding="5,3"

                                         FontSize="12"

                                         Foreground="{DynamicResource PrimaryTextBrush}"

                                         Background="{DynamicResource OverlayPanelBrush}"

                                         BorderBrush="{DynamicResource PanelBorderBrush}"

                                         Text="{Binding MotorTargetPanText, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Column="3"

                                           VerticalAlignment="Center"

                                           Foreground="{DynamicResource SecondaryTextBrush}"

                                           FontSize="15"

                                           FontWeight="Bold"

                                           Text="Tilt" />

                                    <TextBox Grid.Column="4"

                                         Height="29"

                                         Padding="5,3"

                                         FontSize="12"

                                         Foreground="{DynamicResource PrimaryTextBrush}"

                                         Background="{DynamicResource OverlayPanelBrush}"

                                         BorderBrush="{DynamicResource PanelBorderBrush}"

                                         Text="{Binding MotorTargetTiltText, UpdateSourceTrigger=PropertyChanged}" />

                                </Grid>

                                <Button Grid.Row="2"

                                    Height="29"

                                    Margin="0,12,0,0"

                                    Command="{Binding SendMotorTargetCommand}"

                                    Style="{DynamicResource TopBarSmallButton}"

                                    Content="Enter" Click="MotorAngleEntry_OnClick" />

                            </Grid>

                        </Border>



                        <Border Grid.Row="4"

                            Margin="0,12,0,0"

                            Style="{DynamicResource GlassCardBorder}">

                            <Grid Margin="10"

                              VerticalAlignment="Top">

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                </Grid.RowDefinitions>

                                <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"

                                       FontSize="16"

                                       FontWeight="Bold"

                                       Text="Step Size (+/-)" />

                                <Grid Grid.Row="1" Margin="0,10,0,0">

                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="Auto" />

                                        <RowDefinition Height="Auto" />

                                    </Grid.RowDefinitions>



                                    <Grid>

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="Auto" />

                                            <RowDefinition Height="Auto" />

                                            <RowDefinition Height="Auto" />

                                            <RowDefinition Height="Auto" />

                                        </Grid.RowDefinitions>

                                        <Button Height="24" Padding="6,1" FontSize="12" FontWeight="Bold" HorizontalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Auto:Pan:Reset" Style="{DynamicResource TopBarSmallButton}" Content="Auto Pan" />

                                        <Grid Grid.Row="1" Margin="0,6,0,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="7" />

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="7" />

                                                <ColumnDefinition Width="*" />

                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Height="31" Padding="0" FontSize="17" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Auto:Pan:-1" Style="{DynamicResource TopBarButton}" Content="-" />

                                            <Border Grid.Column="2" Height="33" Background="{DynamicResource OverlayPanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="2">

                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" Text="{Binding AutoPanMotorStepSizeText}" />

                                            </Border>

                                            <Button Grid.Column="4" Height="31" Padding="0" FontSize="17" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Auto:Pan:1" Style="{DynamicResource TopBarButton}" Content="+" />

                                        </Grid>

                                        <Button Grid.Row="2" Margin="0,8,0,0" Height="24" Padding="6,1" FontSize="12" FontWeight="Bold" HorizontalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Auto:Tilt:Reset" Style="{DynamicResource TopBarSmallButton}" Content="Auto Tilt" />

                                        <Grid Grid.Row="3" Margin="0,6,0,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="7" />

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="7" />

                                                <ColumnDefinition Width="*" />

                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Height="31" Padding="0" FontSize="17" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Auto:Tilt:-1" Style="{DynamicResource TopBarButton}" Content="-" />

                                            <Border Grid.Column="2" Height="33" Background="{DynamicResource OverlayPanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="2">

                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" Text="{Binding AutoTiltMotorStepSizeText}" />

                                            </Border>

                                            <Button Grid.Column="4" Height="31" Padding="0" FontSize="17" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Auto:Tilt:1" Style="{DynamicResource TopBarButton}" Content="+" />

                                        </Grid>

                                    </Grid>



                                    <Grid Grid.Row="1" Margin="0,14,0,0">

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="Auto" />

                                            <RowDefinition Height="Auto" />

                                            <RowDefinition Height="Auto" />

                                            <RowDefinition Height="Auto" />

                                        </Grid.RowDefinitions>

                                        <Button Height="24" Padding="6,1" FontSize="12" FontWeight="Bold" HorizontalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Manual:Pan:Reset" Style="{DynamicResource TopBarSmallButton}" Content="Manual Pan" />

                                        <Grid Grid.Row="1" Margin="0,6,0,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="7" />

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="7" />

                                                <ColumnDefinition Width="*" />

                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Height="31" Padding="0" FontSize="17" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Manual:Pan:-1" Style="{DynamicResource TopBarButton}" Content="-" />

                                            <Border Grid.Column="2" Height="33" Background="{DynamicResource OverlayPanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="2">

                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" Text="{Binding ManualPanMotorStepSizeText}" />

                                            </Border>

                                            <Button Grid.Column="4" Height="31" Padding="0" FontSize="17" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Manual:Pan:1" Style="{DynamicResource TopBarButton}" Content="+" />

                                        </Grid>

                                        <Button Grid.Row="2" Margin="0,8,0,0" Height="24" Padding="6,1" FontSize="12" FontWeight="Bold" HorizontalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Manual:Tilt:Reset" Style="{DynamicResource TopBarSmallButton}" Content="Manual Tilt" />

                                        <Grid Grid.Row="3" Margin="0,6,0,0">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="7" />

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="7" />

                                                <ColumnDefinition Width="*" />

                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Height="31" Padding="0" FontSize="17" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Manual:Tilt:-1" Style="{DynamicResource TopBarButton}" Content="-" />

                                            <Border Grid.Column="2" Height="33" Background="{DynamicResource OverlayPanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="2">

                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" Text="{Binding ManualTiltMotorStepSizeText}" />

                                            </Border>

                                            <Button Grid.Column="4" Height="31" Padding="0" FontSize="17" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding AdjustMotorStepCommand}" CommandParameter="Manual:Tilt:1" Style="{DynamicResource TopBarButton}" Content="+" />

                                        </Grid>

                                    </Grid>

                                </Grid>

                                <TextBlock Grid.Row="2"

                                       Margin="0,4,0,3"

                                       HorizontalAlignment="Center"

                                       Foreground="{DynamicResource PrimaryTextBrush}"

                                       FontSize="13"

                                       FontWeight="SemiBold"

                                       ><Run Text="A"/><Run Text="uto"/><Run Text=" "/><Run Text=": + / -&#xA;"/><Run Language="ko-kr" Text="M"/><Run Text="anual"/><Run Text=" "/><Run Text=": Ctrl + / -"/></TextBlock>

                            </Grid>

                        </Border>

                    </Grid>
</UserControl>
