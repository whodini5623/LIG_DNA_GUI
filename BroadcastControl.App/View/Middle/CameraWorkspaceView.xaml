<UserControl x:Class="BroadcastControl.App.View.Middle.CameraWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:middle="clr-namespace:BroadcastControl.App.View.Middle">
  <Grid><Border x:Name="CameraPanel"

                        Grid.Row="0"

                        Margin="0,0,0,8"

                        Style="{DynamicResource GlassCardBorder}"

                        BorderBrush="#00000000"

                        CornerRadius="2">

                            <Grid x:Name="CameraViewport"

                          ClipToBounds="True"

                          SizeChanged="CameraViewport_OnSizeChanged"

                          MouseLeftButtonDown="CameraViewport_OnMouseLeftButtonDown"

                          MouseWheel="CameraViewport_OnMouseWheel"

                          MouseMove="CameraViewport_OnMouseMove"

                          MouseLeftButtonUp="CameraViewport_OnMouseLeftButtonUp">

                                <Rectangle Fill="{DynamicResource SurfaceAltBrush}" />



                                <!-- LargeFeedImage???�게 보여�?카메???�상 바인?�임.

                             EO/IR ?�왑 ?�태???�라 ?�시 ?�상???�라�? -->

                                <Image Source="{Binding CameraWorkspace.LargeFeedImage}"

                               Margin="0"

                               Stretch="{Binding LargeFeedStretch}"

                               RenderOptions.BitmapScalingMode="HighQuality"

                               HorizontalAlignment="Center"

                               VerticalAlignment="Center"

                               RenderTransformOrigin="0.5,0.5">

                                    <Image.RenderTransform>

                                        <TransformGroup>

                                            <RotateTransform Angle="{Binding LargeFeedRotationAngle}" />

                                            <ScaleTransform ScaleX="{Binding LargeFeedScale}"

                                                    ScaleY="{Binding LargeFeedScale}" />

                                            <TranslateTransform X="{Binding ZoomTransformX}"

                                                        Y="{Binding ZoomTransformY}" />

                                        </TransformGroup>

                                    </Image.RenderTransform>

                                </Image>



                                <!-- 좌상???�벨?� ?�재 ???�면??카메??종류 ?�시?? -->

                                <Border Margin="16,12,0,0"

                                HorizontalAlignment="Left"

                                VerticalAlignment="Top"

                                Style="{DynamicResource OverlayCardBorder}"

                                BorderThickness="0"

                                CornerRadius="2"

                                Padding="8,4">

                                    <DockPanel LastChildFill="False">

                                        <TextBlock DockPanel.Dock="Left"

                                           Foreground="{DynamicResource PrimaryTextBrush}"

                                           FontSize="17"

                                           FontWeight="Bold"

                                           Text="{Binding LargeFeedTitle}" />

                                        <Button DockPanel.Dock="Right"

                                        Margin="10,0,0,0"

                                        Click="RotateLargeFeedButton_OnClick"

                                        Style="{DynamicResource InlineRotateButton}">

                                            <materialDesign:PackIcon Kind="RotateRight" Width="14" Height="14" />

                                        </Button>

                                    </DockPanel>

                                </Border>



                                <!-- ?�자 �?미니�?

                             ?��? �??�체 ?�면 ?��??�재 보고 ?�는 ?�역???��? 지?�처???�시?? -->

                                <Border Width="152"

                                Height="108"

                                Margin="18,0,0,20"

                                HorizontalAlignment="Left"

                                VerticalAlignment="Bottom"

                                Style="{DynamicResource OverlayCardBorder}"

                                CornerRadius="2"

                                Visibility="{Binding ShowZoomMiniMap, Converter={StaticResource BoolToVisibilityConverter}}">

                                    <Grid Margin="10">

                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"

                                           FontSize="11"

                                           Text="{Binding Text[ZoomMiniMap]}" />

                                        <Canvas Width="130"

                                        Height="74"

                                        Margin="0,18,0,0"

                                        HorizontalAlignment="Center"

                                        VerticalAlignment="Top">

                                            <Rectangle Width="130"

                                               Height="74"

                                               Fill="#55333F4D"

                                               Stroke="#FF64748B"

                                               StrokeThickness="1" />

                                            <Rectangle Width="{Binding MiniMapViewportWidth}"

                                               Height="{Binding MiniMapViewportHeight}"

                                               Canvas.Left="{Binding MiniMapViewportLeft}"

                                               Canvas.Top="{Binding MiniMapViewportTop}"

                                               Fill="#3300FFAA"

                                               Stroke="{DynamicResource AccentBrush}"

                                               StrokeThickness="1.5" />

                                        </Canvas>

                                    </Grid>

                                </Border>



                                <middle:DetectionOverlayView x:Name="DetectionOverlay" />



                                <!-- IR/EO ?�셋 ?�면:

                             ?��? ?�면 ?�릭 ?????�면�??�왑?�는 ?�력 ?�역?? -->

                                <Button Width="168"

                                Height="124"

                                Margin="0,8,26,0"

                                HorizontalAlignment="Right"

                                VerticalAlignment="Top"

                                Command="{Binding SwapFeedsCommand}"

                                Background="Transparent"

                                BorderThickness="0"

                                Padding="0">

                                    <!-- IR ?�셋?� ?�상�?보이?�록 ?��? 배경�??�두리�? ?�거?? -->

                                    <Border Background="Transparent"

                                    BorderBrush="Transparent"

                                    BorderThickness="0"

                                    CornerRadius="1">

                                        <Grid ClipToBounds="True">

                                            <Image Source="{Binding CameraWorkspace.InsetFeedImage}"

                                           Stretch="{Binding InsetFeedStretch}"

                                           RenderOptions.BitmapScalingMode="HighQuality"

                                           HorizontalAlignment="Center"

                                           VerticalAlignment="Center"

                                           RenderTransformOrigin="0.5,0.5">

                                                <Image.RenderTransform>

                                                    <RotateTransform Angle="{Binding InsetFeedRotationAngle}" />

                                                </Image.RenderTransform>

                                            </Image>

                                            <Border Margin="10,10,0,0"

                                             HorizontalAlignment="Left"

                                             VerticalAlignment="Top"

                                             Style="{DynamicResource OverlayCardBorder}"

                                             BorderThickness="0"

                                             CornerRadius="2"

                                             Padding="7,3">

                                                <DockPanel LastChildFill="False">

                                                    <TextBlock DockPanel.Dock="Left"

                                                       Foreground="{DynamicResource PrimaryTextBrush}"

                                                       FontSize="13"

                                                       FontWeight="Bold"

                                                       Text="{Binding InsetFeedTitle}" />

                                                    <Button DockPanel.Dock="Right"

                                                    Margin="8,0,0,0"

                                                    Click="RotateInsetFeedButton_OnClick"

                                                    Style="{DynamicResource InlineRotateButton}">

                                                        <materialDesign:PackIcon Kind="RotateRight" Width="12" Height="12" />

                                                    </Button>

                                                </DockPanel>

                                            </Border>

                                        </Grid>

                                    </Border>

                                </Button>



                                <!-- 모터 방향 버튼:

                             ?�동 모드?�서�??�시?�며 ?�후 ?�제 모터 ?�어 명령�??�결???�치?? -->

                                <Grid Margin="0,0,24,26"

                              HorizontalAlignment="Right"

                              VerticalAlignment="Bottom"

                              Visibility="Collapsed">

                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="Auto" />

                                        <RowDefinition Height="Auto" />

                                        <RowDefinition Height="Auto" />

                                        <RowDefinition Height="Auto" />

                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="Auto" />

                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0"

                                    Grid.Column="0"

                                    Grid.ColumnSpan="3"

                                    Margin="0,0,0,8"

                                    Padding="12,5"

                                    Background="#DD05070A"

                                    BorderBrush="{DynamicResource PanelBorderBrush}"

                                    BorderThickness="1"

                                    CornerRadius="2">

                                        <TextBlock HorizontalAlignment="Center"

                                           Foreground="{DynamicResource PrimaryTextBrush}"

                                           FontSize="16"

                                           FontWeight="Bold"

                                           Text="{Binding Text[MotorControl]}" />

                                    </Border>



                                    <Button Grid.Row="1"

                                    Grid.Column="1"

                                    Tag="Up"

                                    IsEnabled="{Binding CanUseMotorControls}"

                                    PreviewMouseLeftButtonDown="MotorButton_OnPreviewMouseLeftButtonDown"

                                    PreviewMouseLeftButtonUp="MotorButton_OnPreviewMouseLeftButtonUp"

                                    MouseLeave="MotorButton_OnMouseLeave"

                                    Style="{DynamicResource ArrowButton}">

                                        <materialDesign:PackIcon Kind="ArrowUpBold" Width="20" Height="20" />

                                    </Button>

                                    <Button Grid.Row="2"

                                    Grid.Column="0"

                                    Margin="0,6,6,6"

                                    Tag="Left"

                                    IsEnabled="{Binding CanUseMotorControls}"

                                    PreviewMouseLeftButtonDown="MotorButton_OnPreviewMouseLeftButtonDown"

                                    PreviewMouseLeftButtonUp="MotorButton_OnPreviewMouseLeftButtonUp"

                                    MouseLeave="MotorButton_OnMouseLeave"

                                    Style="{DynamicResource ArrowButton}">

                                        <materialDesign:PackIcon Kind="ArrowLeftBold" Width="20" Height="20" />

                                    </Button>

                                    <Button Grid.Row="2"

                                    Grid.Column="1"

                                    Margin="0,6,0,6"

                                    Tag="Center"

                                    IsEnabled="{Binding CanUseMotorControls}"

                                    PreviewMouseLeftButtonDown="MotorButton_OnPreviewMouseLeftButtonDown"

                                    PreviewMouseLeftButtonUp="MotorButton_OnPreviewMouseLeftButtonUp"

                                    MouseLeave="MotorButton_OnMouseLeave"

                                    Style="{DynamicResource ArrowButton}">

                                        <Ellipse Width="16"

                                         Height="16"

                                         Stroke="{DynamicResource PrimaryTextBrush}"

                                         StrokeThickness="2"

                                         Fill="Transparent" />

                                    </Button>

                                    <Button Grid.Row="2"

                                    Grid.Column="2"

                                    Margin="6,6,0,6"

                                    Tag="Right"

                                    IsEnabled="{Binding CanUseMotorControls}"

                                    PreviewMouseLeftButtonDown="MotorButton_OnPreviewMouseLeftButtonDown"

                                    PreviewMouseLeftButtonUp="MotorButton_OnPreviewMouseLeftButtonUp"

                                    MouseLeave="MotorButton_OnMouseLeave"

                                    Style="{DynamicResource ArrowButton}">

                                        <materialDesign:PackIcon Kind="ArrowRightBold" Width="20" Height="20" />

                                    </Button>

                                    <Button Grid.Row="3"

                                    Grid.Column="1"

                                    Tag="Down"

                                    IsEnabled="{Binding CanUseMotorControls}"

                                    PreviewMouseLeftButtonDown="MotorButton_OnPreviewMouseLeftButtonDown"

                                    PreviewMouseLeftButtonUp="MotorButton_OnPreviewMouseLeftButtonUp"

                                    MouseLeave="MotorButton_OnMouseLeave"

                                    Style="{DynamicResource ArrowButton}">

                                        <materialDesign:PackIcon Kind="ArrowDownBold" Width="20" Height="20" />

                                    </Button>

                                </Grid>



                                <!-- ?�자 �??�널?� 배경??과하�?길어 보이지 ?�도�?고정 ??���?묶음. -->

                                <!-- ?�자 �??�널:

                             �?리셋 버튼, 배율 ?�라?�더, ?�재 배율 ?�스?��? ??묶음?�로 ?�시?? -->

                                <Border Margin="182,0,220,18"

                                Padding="10,7"

                                Width="340"

                                HorizontalAlignment="Center"

                                VerticalAlignment="Bottom"

                                Style="{DynamicResource OverlayCardBorder}"

                                CornerRadius="2"

                                Visibility="Collapsed">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <!-- ?�자 �??�벨?� ?��? 리셋 버튼?? ?�릭 ??x1.0 기본 배율�?복�??? -->

                                        <Button VerticalAlignment="Center"

                                        Command="{Binding ResetZoomCommand}"

                                        Style="{DynamicResource TopBarSmallButton}"

                                        Content="{Binding Text[CamZoom]}" />

                                        <Slider Grid.Column="1"

                                        Margin="12,0"

                                        Minimum="1"

                                        Maximum="4"

                                        TickFrequency="0.1"

                                        IsSnapToTickEnabled="False"

                                        Value="{Binding ZoomLevel, UpdateSourceTrigger=PropertyChanged}"

                                        IsEnabled="{Binding CanUseZoomControls}"

                                        Style="{DynamicResource ZoomSliderStyle}" />

                                        <TextBlock Grid.Column="2"

                                           VerticalAlignment="Center"

                                           Foreground="{DynamicResource SecondaryTextBrush}"

                                           FontSize="13"

                                           Text="{Binding ZoomLevelText}" />

                                    </Grid>

                                </Border>



                                <Border Margin="14,0,14,14"

                                Padding="12"

                                HorizontalAlignment="Stretch"

                                VerticalAlignment="Bottom"

                                Background="#CC1B2431"

                                BorderBrush="{DynamicResource PanelBorderBrush}"

                                BorderThickness="1"

                                CornerRadius="2"

                                Panel.ZIndex="8"

                                Visibility="Collapsed">

                                    <Grid>

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="44" />

                                            <RowDefinition Height="44" />

                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="2.2*" />

                                            <ColumnDefinition Width="1.05*" />

                                            <ColumnDefinition Width="1.05*" />

                                            <ColumnDefinition Width="1.2*" />

                                            <ColumnDefinition Width="1.2*" />

                                        </Grid.ColumnDefinitions>



                                        <StackPanel Grid.Row="0"

                                            Grid.Column="0"

                                            Margin="0,0,12,0"

                                            Orientation="Horizontal"

                                            VerticalAlignment="Center">

                                            <Button Width="88"

                                            Margin="0,0,10,0"

                                            Command="{Binding ResetZoomCommand}"

                                            Style="{DynamicResource TopBarSmallButton}"

                                        Content="{Binding Text[CamZoom]}" />

                                            <Slider Width="210"

                                            Minimum="1"

                                            Maximum="4"

                                            TickFrequency="0.1"

                                            IsSnapToTickEnabled="False"

                                            Value="{Binding ZoomLevel, UpdateSourceTrigger=PropertyChanged}"

                                            IsEnabled="{Binding CanUseZoomControls}" />

                                            <TextBlock Margin="8,0,0,0"

                                               VerticalAlignment="Center"

                                               Foreground="{DynamicResource SecondaryTextBrush}"

                                               FontSize="12"

                                               Text="{Binding ZoomLevelText}" />

                                        </StackPanel>



                                        <Button Grid.Row="0"

                                        Grid.Column="1"

                                        Margin="4,0"

                                        Command="{Binding SetModeCommand}"

                                        CommandParameter="&#xC790;&#xB3D9;"

                                        IsHitTestVisible="{Binding CanSelectAutoMode}"

                                        Opacity="{Binding AutoModeOpacity}"

                                        Style="{DynamicResource TopBarButton}"

                                        Content="{Binding Text[AutoMode]}" />

                                        <Button Grid.Row="0"

                                        Grid.Column="2"

                                        Margin="4,0"

                                        Command="{Binding SetModeCommand}"

                                        CommandParameter="&#xC218;&#xB3D9;"

                                        IsHitTestVisible="{Binding CanSelectManualMode}"

                                        Opacity="{Binding ManualModeOpacity}"

                                        Style="{DynamicResource TopBarButton}"

                                        Content="{Binding Text[ManualMode]}" />



                                        <StackPanel Grid.Row="1"

                                            Grid.Column="0"

                                            Margin="0,0,12,0"

                                            Orientation="Horizontal"

                                            VerticalAlignment="Center">

                                            <Button Width="88"

                                            Margin="0,0,10,0"

                                            Command="{Binding ResetBrightnessCommand}"

                                            Style="{DynamicResource TopBarSmallButton}"

                                            Content="{Binding BrightnessText}" />

                                            <Slider Width="180"

                                            Minimum="0"

                                            Maximum="100"

                                            Value="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}"

                                            IsEnabled="{Binding IsSystemPoweredOn}" />

                                        </StackPanel>



                                        <StackPanel Grid.Row="1"

                                            Grid.Column="1"

                                            Grid.ColumnSpan="2"

                                            Margin="4,0,10,0"

                                            Orientation="Horizontal"

                                            VerticalAlignment="Center">

                                            <Button Width="88"

                                            Margin="0,0,10,0"

                                            Command="{Binding ResetContrastCommand}"

                                            Style="{DynamicResource TopBarSmallButton}"

                                            Content="{Binding ContrastText}" />

                                            <Slider Width="145"

                                            Minimum="0"

                                            Maximum="100"

                                            Value="{Binding Contrast, UpdateSourceTrigger=PropertyChanged}"

                                            IsEnabled="{Binding IsSystemPoweredOn}" />

                                        </StackPanel>



                                        <Button Grid.Row="1"

                                        Grid.Column="3"

                                        Margin="4,0"

                                        Command="{Binding ToggleManualRecordingCommand}"

                                        Opacity="{Binding ManualRecordingButtonOpacity}"

                                        IsEnabled="{Binding IsManualMode}"

                                        Style="{DynamicResource TopBarButton}"

                                        Content="{Binding ManualRecordingButtonText}" />



                                        <StackPanel Grid.Row="0"

                                            Grid.RowSpan="2"

                                            Grid.Column="4"

                                            Margin="8,0,0,0"

                                            VerticalAlignment="Center"

                                            Orientation="Horizontal"

                                            Opacity="{Binding RecordingIndicatorOpacity}">

                                            <Ellipse Width="12"

                                             Height="12"

                                             Margin="0,0,8,0"

                                             Fill="{Binding RecordingIndicatorBrush}" />

                                            <TextBlock VerticalAlignment="Center"

                                               Foreground="{Binding RecordingTextBrush}"

                                               FontSize="13"

                                               FontWeight="SemiBold"

                                               Text="{Binding Text[RecordingStatus]}" />

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </Grid>

                        </Border>
  </Grid>
</UserControl>
